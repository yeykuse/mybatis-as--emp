<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chapter01.GoodsMapper">

    <resultMap id="goodsResultMap" type="com.entity.Goods">
        <id property="id" column="id"/>
        <result property="goodsName" column="goods_name"/>
        <result property="sku" column="sku"/>
        <result property="specification" column="specification"/>
        <result property="stock" column="stock"/>
        <result property="price" column="price"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByMap" parameterType="Map" resultMap="goodsResultMap">
        SELECT * FROM goods WHERE 1=1
        <if test="goodsName != null">
            AND goods_name LIKE CONCAT('%', #{goodsName}, '%')
        </if>
        <if test="sku != null">
            AND sku = #{sku}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
    </select>

    <select id="findProductsByGoodsId" resultType="com.entity.Product">
        SELECT p.* FROM product p
        INNER JOIN product_goods pg ON p.id = pg.product_id
        WHERE pg.goods_id = #{goodsId}
    </select>

    <insert id="insertGoods" parameterType="com.entity.Goods" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO goods (goods_name, sku, specification, stock, price, status)
        VALUES (#{goods.goodsName}, #{goods.sku}, #{goods.specification}, #{goods.stock}, #{goods.price}, #{goods.status})
    </insert>

    <update id="updateGoods" parameterType="com.entity.Goods">
        UPDATE goods
        <set>
            <if test="goods.goodsName != null">goods_name = #{goods.goodsName},</if>
            <if test="goods.sku != null">sku = #{goods.sku},</if>
            <if test="goods.specification != null">specification = #{goods.specification},</if>
            <if test="goods.stock != null">stock = #{goods.stock},</if>
            <if test="goods.price != null">price = #{goods.price},</if>
            <if test="goods.status != null">status = #{goods.status},</if>
        </set>
        WHERE id = #{goods.id}
    </update>

    <delete id="deleteById">
        DELETE FROM goods WHERE id = #{id}
    </delete>

</mapper>