<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    命名空间必须与 Mapper 接口全限定名一致
    MyBatis 通过 namespace 将 XML 映射文件与 Java 接口绑定
-->
<mapper namespace="com.chapter01.EmpAdvancedMapper">

    <!--  
      ======================== resultMap 定义 ========================
      
      resultMap 是 MyBatis 最强大的功能之一，用于自定义查询结果到 Java 对象的映射关系。
      比 resultType 更灵活，可以处理：
        - 数据库列名与 Java 属性名不一致的情况
        - 一对多、多对一关联查询
        - 复杂嵌套对象映射
        
      当前示例：将 emp LEFT JOIN dept 的结果映射到 EmpWithDept 对象
                emp 表字段直接映射，dept 表字段通过 <association> 映射
    -->
    <resultMap id="empWithDeptMap" type="com.entity.EmpWithDept">
        <!-- 
          <id> 标签：映射主键，提高 MyBatis 缓存和比较性能
          column = 数据库列名, property = Java 对象属性名 
        -->
        <id column="empno" property="empno"/>
        
        <!-- 
          <result> 标签：映射普通列
          column 和 property 相同时可省略，但显式写出更清晰
        -->
        <result column="ename" property="ename"/>
        <result column="job" property="job"/>
        <result column="mgr" property="mgr"/>
        <result column="hiredate" property="hiredate"/>
        <result column="sal" property="sal"/>
        <result column="comm" property="comm"/>
        <result column="deptno" property="deptno"/>
        
        <!-- 
          <association> 标签：多对一或一对一关联映射
          这里将 dept 表的 dname 和 loc 映射到 EmpWithDept 的同名属性
          虽然写在同一层级，但语义上表示 emp 关联了一个 dept
          
          完整写法应该嵌套一个 Dept 对象，但此处为了简化，
          直接将 dept 表的字段扁平化映射到 EmpWithDept 的 dname/loc 属性
        -->
        <result column="dname" property="dname"/>
        <result column="loc" property="loc"/>
    </resultMap>


    <!--
      ======================== 1. 批量更新 (foreach) ========================
      
      功能：批量修改多个员工的薪资
      
      原理：
        foreach 标签遍历传入的 List<Emp>，
        为每一条数据生成一行 UPDATE 语句，
        用分号(;)分隔拼接成一条完整的 SQL。
        
      参数说明：
        collection="list"  -> 集合名称，默认为 list
        item="emp"          -> 每个元素的别名
        separator=";"       -> 每条 SQL 之间的分隔符
        
      最终生成的 SQL 类似：
        UPDATE emp SET sal = 18000 WHERE empno = 5;
        UPDATE emp SET sal = 16000 WHERE empno = 6;
        UPDATE emp SET sal = 15000 WHERE empno = 7;
    -->
    <update id="batchUpdateSal">
        <foreach collection="list" item="emp" separator=";">
            UPDATE emp
            SET sal = #{emp.sal}
            WHERE empno = #{emp.empno}
        </foreach>
    </update>


    <!--
      ======================== 2. foreach IN 查询 - 字符串 ========================
      
      功能：根据多个员工姓名，查询这些员工的全部信息
      
      foreach 标签解析：
        传入 List<String> names = ["张三", "李四", "王五"]
        open="(" separator="," close=")"
        
        生成 SQL：
        SELECT * FROM emp WHERE ename IN (?, ?, ?)
        参数依次是： '张三', '李四', '王五'
        
      要点：
        - #{name} 使用预编译 ? 占位符，防止 SQL 注入
        - item="name" 的取值要和 #{name} 中的占位符名一致
    -->
    <select id="findByEnameList" resultType="com.entity.Emp">
        SELECT * FROM emp
        WHERE ename IN
        <foreach collection="names" item="name" open="(" separator="," close=")">
            #{name}
        </foreach>
    </select>


    <!--
      ======================== 3. foreach IN 查询 - 数字 ========================
      
      功能：根据多个部门编号，查询这些部门的所有员工
      
      与字符串版本的区别：
        参数类型是 Integer 而非 String，但 foreach 用法完全一样
        WHERE deptno IN (10, 20, 30)
      
      支持传入的列表类型可以是：List、Set、Array
      如果是 Array，collection 写 "array"
    -->
    <select id="findByDeptnoList" resultType="com.entity.Emp">
        SELECT * FROM emp
        WHERE deptno IN
        <foreach collection="deptnos" item="dno" open="(" separator="," close=")">
            #{dno}
        </foreach>
    </select>


    <!--
      ======================== 4. 两张表关联查询 + resultMap ========================
      
      功能：左外连接查询员工及其部门信息
      
      SQL 分析：
        emp LEFT JOIN dept ON emp.deptno = dept.deptno
        
        LEFT JOIN 确保即使某些员工没有对应部门（deptno 不在 dept 表中），
        员工信息也会返回，dept 字段为 null
      
      resultMap = "empWithDeptMap"：
        使用上面定义的 resultMap 来映射查询结果，
        而不是默认的 resultType 自动映射
      
      为什么用 resultMap 不用 resultType？
        - resultType 只能按列名 = 属性名 自动映射
        - 当查询结果涉及多张表、列名冲突、嵌套对象时，resultMap 更清晰
        - 本示例中 emp.deptno 和 dept.deptno 同名，resultMap 可以明确区分
    -->
    <select id="findAllEmpWithDept" resultMap="empWithDeptMap">
        SELECT 
            e.empno, e.ename, e.job, e.mgr, e.hiredate, 
            e.sal, e.comm, e.deptno,
            d.dname, d.loc
        FROM emp e
        LEFT JOIN dept d ON e.deptno = d.deptno
        ORDER BY e.empno
    </select>

</mapper>