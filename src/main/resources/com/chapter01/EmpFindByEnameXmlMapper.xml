<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chapter01.EmpFindByEnameXmlMapper">

    <select id="findByEnameLikeXml" parameterType="string" resultType="com.entity.Emp">
        SELECT * FROM emp WHERE ename LIKE CONCAT('%', #{value}, '%')
    </select>

</mapper>